MYSQL_DATABASE=shop_core
MYSQL_USER=shop
MYSQL_PASSWORD=shop_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

JWT_SECRET=replace-with-at-least-32-characters
APP_ENV=development
AUTH_ISSUER=goblog
AUTH_AUDIENCE=goblog-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_CODE_TTL=5m
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
BOOTSTRAP_ADMIN_EMAIL=
SNOWFLAKE_NODE_ID=0
REALTIME_MAX_CONNECTIONS=1000
REALTIME_FALLBACK_COOLDOWN=1m
METRICS_ADDR=:9091
PROMETHEUS_URL=http://prometheus:9090
