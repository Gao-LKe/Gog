<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>话题 - GameBog</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    .page-topics { background: var(--bg); }
    .page-topics .container { max-width: 960px; }

    .topics-layout {
      display: flex;
      align-items: flex-start;
      gap: 28px;
      padding-top: 32px;
    }

    /* 左侧主区 */
    .topics-main { flex: 1; min-width: 0; }
    .topics-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .topics-header h1 {
      font-size: 22px;
      font-weight: 700;
      margin: 0;
    }
    .topics-count {
      font-size: 14px;
      color: #86868b;
      background: #f0f0f2;
      padding: 4px 12px;
      border-radius: 999px;
    }

    .topic-card {
      background: #fff;
      border: 1px solid #e8e8ed;
      border-radius: 14px;
      padding: 18px 20px;
      margin-bottom: 10px;
      transition: all .2s;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .topic-card:hover {
      border-color: #c7c7cc;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .topic-card:active { transform: scale(0.995); }
    .topic-card-body { flex: 1; min-width: 0; }
    .topic-card-title {
      font-size: 16px;
      font-weight: 600;
      color: #1d1d1f;
      text-decoration: none;
      display: block;
      margin-bottom: 4px;
    }
    .topic-card-title:hover { text-decoration: underline; }
    .topic-card-meta {
      font-size: 12px;
      color: #a1a1a6;
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .topic-card-badge {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      font-weight: 500;
    }
    .badge-permanent { background: #e8f5e9; color: #2e7d32; }
    .badge-temporary { background: #fff3e0; color: #e65100; }
    .topic-card-expires { font-size: 11px; color: #a1a1a6; }

    .topics-empty {
      text-align: center;
      padding: 60px 20px;
      color: #a1a1a6;
    }
    .topics-empty-icon { font-size: 40px; margin-bottom: 10px; opacity: .4; }
    .topics-empty-text { font-size: 14px; }

    .topics-pager {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 20px;
      padding: 12px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid #e8e8ed;
    }
    .topics-pager button {
      padding: 6px 16px;
      font-size: 13px;
      border-radius: 8px;
      border: 1px solid #e8e8ed;
      background: #fff;
      color: #1d1d1f;
      cursor: pointer;
      transition: all .15s;
    }
    .topics-pager button:hover:not(:disabled) { background: #f5f5f7; }
    .topics-pager button:disabled { opacity: .4; cursor: default; }
    .topics-pager-info { font-size: 13px; color: #86868b; }

    /* 右侧创建面板 */
    .topics-side { flex: 0 0 300px; }
    .topics-card {
      background: #fff;
      border: 1px solid #e8e8ed;
      border-radius: 14px;
      padding: 24px 20px;
      position: sticky;
      top: 20px;
    }
    .topics-card h2 {
      font-size: 16px;
      font-weight: 700;
      margin: 0 0 4px;
    }
    .topics-card-desc {
      font-size: 13px;
      color: #86868b;
      line-height: 1.5;
      margin-bottom: 16px;
    }
    .topics-form-group { margin-bottom: 14px; }
    .topics-form-group label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #555;
      margin-bottom: 4px;
    }
    .topics-form-group input[type="text"] {
      width: 100%;
      padding: 10px 12px;
      font-size: 14px;
      border: 1px solid #e8e8ed;
      border-radius: 10px;
      outline: none;
      transition: border-color .2s;
      box-sizing: border-box;
    }
    .topics-form-group input[type="text"]:focus {
      border-color: #0071e3;
      box-shadow: 0 0 0 3px rgba(0,113,227,0.08);
    }
    .topics-kind-group {
      display: flex;
      gap: 12px;
      margin-bottom: 14px;
    }
    .topics-kind-option {
      flex: 1;
      padding: 8px;
      border: 1px solid #e8e8ed;
      border-radius: 10px;
      text-align: center;
      cursor: pointer;
      transition: all .2s;
      font-size: 13px;
    }
    .topics-kind-option:hover { border-color: #c7c7cc; }
    .topics-kind-option input { display: none; }
    .topics-kind-option input:checked + .topics-kind-label {
      color: #0071e3;
    }
    .topics-kind-option:has(input:checked) {
      border-color: #0071e3;
      background: rgba(0,113,227,0.04);
    }
    .topics-kind-label {
      cursor: pointer;
      color: #555;
      font-weight: 500;
    }
    .topics-kind-label small {
      display: block;
      font-size: 11px;
      color: #aaa;
      font-weight: 400;
      margin-top: 2px;
    }
    .topics-submit-btn {
      width: 100%;
      padding: 10px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      border-radius: 10px;
      background: #111;
      color: #fff;
      cursor: pointer;
      transition: opacity .2s;
    }
    .topics-submit-btn:hover { opacity: .85; }
    .topics-submit-btn:disabled { opacity: .4; cursor: default; }
    .topics-form-msg {
      font-size: 12px;
      color: #86868b;
      margin-top: 8px;
      text-align: center;
    }

    @media (max-width: 780px) {
      .topics-layout { flex-direction: column; }
      .topics-side { flex: none; width: 100%; }
      .topics-card { position: static; }
    }
  </style>
</head>
<body class="page-topics">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <div class="topics-layout container">
    <!-- 左侧话题列表 -->
    <main class="topics-main">
      <div class="topics-header">
        <h1>📂 话题</h1>
        <span class="topics-count" id="topicCount">加载中...</span>
      </div>
      <div id="topicList"></div>
      <div class="topics-empty" id="topicEmpty" style="display:none">
        <div class="topics-empty-icon">📭</div>
        <div class="topics-empty-text">暂无话题</div>
      </div>
      <div class="topics-pager" id="topicPager">
        <button id="topicPrev" disabled>← 上一页</button>
        <span class="topics-pager-info" id="topicPageInfo"></span>
        <button id="topicNext" disabled>下一页 →</button>
      </div>
    </main>

    <!-- 右侧创建面板 -->
    <aside class="topics-side">
      <div class="topics-card">
        <h2>✎ 创建话题</h2>
        <div class="topics-card-desc">长期话题需管理员审核，临时话题 48 小时后自动清理。</div>
        <div class="topics-form-group">
          <label>话题名称</label>
          <input type="text" id="topicNameInput" maxlength="50" placeholder="例如：Go 并发 / 缓存 / 架构" />
        </div>
        <div class="topics-kind-group">
          <label class="topics-kind-option">
            <input type="radio" name="topicKind" value="long" checked />
            <span class="topics-kind-label">长期 <small>需审核</small></span>
          </label>
          <label class="topics-kind-option">
            <input type="radio" name="topicKind" value="temporary" />
            <span class="topics-kind-label">临时 <small>48h 清理</small></span>
          </label>
        </div>
        <button type="button" class="topics-submit-btn" id="topicCreateBtn">创建话题</button>
        <div class="topics-form-msg" id="topicCreateMsg"></div>
      </div>
    </aside>
  </div>

  <script src="/static/app.js"></script>
  <script src="/static/topics.js"></script>
</body>
</html>
