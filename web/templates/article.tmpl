<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>文章 - GameBog</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <link rel="stylesheet" href="/static/vendor/hljs-github-dark-dimmed.min.css" />
  <style>
    .page-article {
      background: linear-gradient(180deg, #f6f7f9 0%, #eef0f4 100%);
      min-height: 100vh;
    }
    .page-article .container { max-width: 1120px; }

    .article-shell { display: flex; align-items: flex-start; gap: 24px; padding: 32px 0 48px; }

    .article-main { flex: 1; min-width: 0; }

    .article-cover {
      margin: 0 0 18px;
      border-radius: 14px;
      overflow: hidden;
      background: #0f172a;
    }
    .article-cover img {
      width: 100%;
      height: auto;
      max-height: min(52vh, 520px);
      object-fit: cover;
      display: block;
      vertical-align: middle;
    }

    .article-hd {
      padding: 36px 40px 28px; margin-bottom: 20px;
      background: #fff;
      border: 1px solid rgba(0,0,0,.06);
      border-radius: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
    }
    .article-hd h1 {
      font-size: clamp(22px, 2.4vw, 30px);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0 0 14px;
      line-height: 1.28;
      color: #0a0a0b;
    }

    .article-meta {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      font-size: 13px; color: #6e6e73; margin-bottom: 12px;
    }
    .article-meta .stat {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(0,0,0,.04);
      color: #424245;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
    }
    .article-meta .stat-icon { opacity: .85; }

    .article-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
    .tag {
      font-size: 12px; font-weight: 500;
      padding: 4px 12px; border-radius: 999px;
      background: rgba(0,113,227,.08); color: #0071e3;
      border: 1px solid rgba(0,113,227,.12);
    }

    .article-byline {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
      padding: 18px 0 0; border-top: 1px solid rgba(0,0,0,.06); margin-top: 8px;
    }
    .article-author { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .article-author-avatar {
      width: 44px; height: 44px; border-radius: 50%;
      background: linear-gradient(145deg, #5ac8fa 0%, #0071e3 100%);
      color: #fff; display: flex; align-items: center; justify-content: center;
      font-size: 15px; font-weight: 600; flex-shrink: 0;
      overflow: hidden;
    }
    .article-author-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .article-author-info { display: flex; flex-direction: column; min-width: 0; }
    .article-author-name { font-size: 15px; font-weight: 600; color: #1d1d1f; }
    .article-author-name a { color: inherit; text-decoration: none; }
    .article-author-name a:hover { color: #0071e3; }
    .article-author-extra { font-size: 12px; color: #86868b; margin-top: 2px; }

    .article-actions-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0; }
    .article-actions {
      display: flex; align-items: center; gap: 8px;
    }
    .article-action-hint {
      font-size: 12px; color: #86868b;
      max-width: 220px; text-align: right;
      min-height: 1.2em;
    }
    .article-action-btn {
      min-width: 40px; height: 40px; padding: 0 10px; border-radius: 12px;
      border: 1px solid rgba(0,0,0,.08); background: #fafafa;
      cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
      transition: background .15s, border-color .15s, color .15s, box-shadow .15s;
      font-size: 15px; color: #3a3a3c;
      gap: 4px;
    }
    .article-action-btn:hover {
      background: #fff;
      border-color: rgba(0,0,0,.12);
      box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }
    .article-action-btn.active { background: rgba(0,113,227,.1); border-color: rgba(0,113,227,.35); color: #0071e3; }
    .article-action-btn:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }
    /* 勿用全局 .badge（styles.css 里为红色角标圆点） */
    .article-action-btn .article-like-count {
      font-size: 12px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: inherit;
      margin-left: 2px;
      line-height: 1;
    }

    .article-body {
      background: #fff; border: 1px solid rgba(0,0,0,.06); border-radius: 20px;
      padding: 40px 44px; margin-bottom: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
    }
    .article-body .content { line-height: 1.75; font-size: 16px; color: #1d1d1f; }
    .article-body .content h1, .article-body .content h2, .article-body .content h3,
    .article-body .content h4 { margin-top: 1.4em; margin-bottom: .6em; font-weight: 700; }
    .article-body .content p { margin: 0 0 1em; }
    .article-body .content img { max-width: 100%; border-radius: 10px; }
    .article-body .content blockquote {
      margin: 1em 0; padding: 12px 18px; border-left: 4px solid #667eea;
      background: #f8f9ff; border-radius: 8px; color: #555;
    }
    .article-body .content pre {
      background: #f5f5f7; border-radius: 10px; padding: 16px; overflow-x: auto;
      font-size: 14px; line-height: 1.5;
    }
    .article-body .content code { font-family: 'SF Mono', 'Fira Code', monospace; }
    .article-body .content a { color: #0071e3; }

    /* 评论区 */
    .comment-section {
      background: #fff; border: 1px solid rgba(0,0,0,.06); border-radius: 20px;
      padding: 28px 32px 32px; margin-bottom: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
    }
    .comment-section h2 {
      font-size: 18px; font-weight: 700; letter-spacing: -0.01em;
      margin: 0 0 20px; display: flex; align-items: baseline; gap: 10px; color: #0a0a0b;
    }

    .comment-input-wrap {
      display: flex; flex-direction: column; gap: 0;
      background: #f5f5f7; border: 1px solid rgba(0,0,0,.08); border-radius: 16px;
      padding: 0; transition: border-color .2s, box-shadow .2s;
    }
    .comment-input-wrap:focus-within {
      border-color: rgba(0,113,227,.45);
      box-shadow: 0 0 0 3px rgba(0,113,227,.12);
    }
    .comment-editor-host { position: relative; padding: 14px 16px 10px; }
    .cy-float-pop {
      position: absolute; right: 12px; top: 10px; z-index: 2;
      opacity: 0; transform: translateY(6px);
      pointer-events: none;
      transition: opacity .2s ease, transform .2s ease;
    }
    .comment-editor-host.cy-float-visible .cy-float-pop {
      opacity: 1; transform: translateY(0); pointer-events: auto;
    }
    .cy-insert-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; font-size: 12px; font-weight: 600;
      border-radius: 10px; border: 1px solid rgba(0,0,0,.1);
      background: #fff; color: #3a3a3c; cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }
    .cy-insert-btn:hover { border-color: #0071e3; color: #0071e3; }
    .cy-insert-btn:disabled { opacity: .5; cursor: not-allowed; }
    .comment-input-wrap textarea {
      width: 100%; border: none; outline: none; resize: vertical;
      font-size: 15px; font-family: inherit; line-height: 1.55;
      background: transparent; min-height: 72px; padding: 0 4px 0 0;
      color: #1d1d1f;
    }
    .comment-input-footer {
      display: flex; align-items: center; justify-content: space-between;
      gap: 10px;
      padding: 10px 16px 12px; border-top: 1px solid rgba(0,0,0,.06);
      background: rgba(255,255,255,.65);
      border-radius: 0 0 16px 16px;
    }
    .comment-input-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-width: 0; }
    .comment-input-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .comment-reply-hint { font-size: 12px; color: #86868b; }
    .comment-reply-hint button { background: none; border: none; color: #0071e3; cursor: pointer; font-size: 12px; padding: 0; }
    .comment-submit-btn {
      padding: 8px 20px; font-size: 14px; font-weight: 600;
      border: none; border-radius: 10px; background: #0071e3; color: #fff;
      cursor: pointer; transition: background .2s; white-space: nowrap;
    }
    .comment-submit-btn:hover { background: #0058b0; }
    .comment-submit-btn:disabled { background: #d1d1d6; cursor: default; }
    .comment-msg { font-size: 12px; color: #86868b; margin-top: 6px; }

    /* 评论列表 */
    .comment-list { display: flex; flex-direction: column; gap: 0; }
    .comment-item {
      padding: 18px 0; border-bottom: 1px solid rgba(0,0,0,.06);
    }
    .comment-item:last-child { border-bottom: none; }
    .comment-item--cy {
      background: linear-gradient(90deg, rgba(255,193,7,.08) 0%, transparent 48%);
      margin: 0 -12px; padding-left: 12px; padding-right: 12px;
      border-radius: 12px;
    }
    .comment-header { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .comment-avatar {
      width: 30px; height: 30px; border-radius: 50%;
      background: #e8e8ed; color: #555;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 600; flex-shrink: 0;
    }
    .comment-user { font-size: 13px; font-weight: 600; }
    .comment-badge {
      font-size: 10px; padding: 2px 8px; border-radius: 999px;
      background: rgba(255,193,7,.25); color: #7a5a00; font-weight: 600;
      letter-spacing: .02em;
    }
    .comment-time { font-size: 11px; color: #a1a1a6; margin-left: auto; }
    .comment-content {
      font-size: 14px; line-height: 1.55; color: #1d1d1f;
      white-space: pre-wrap; word-break: break-word; padding-left: 40px;
    }
    .comment-actions { display: flex; gap: 8px; padding-left: 40px; margin-top: 4px; }
    .comment-actions button {
      background: none; border: none; font-size: 12px; color: #86868b;
      cursor: pointer; padding: 2px 0;
    }
    .comment-actions button:hover { color: #0071e3; }

    /* 子评论 */
    .comment-children { padding-left: 40px; margin-top: 8px; border-left: 2px solid #e8e8ed; }
    .comment-child { padding: 10px 0 10px 12px; }
    .comment-child .comment-content { padding-left: 0; }
    .comment-child .comment-actions { padding-left: 0; }
    .comment-empty { text-align: center; padding: 32px; color: #a1a1a6; font-size: 14px; }

    /* 左侧 TOC */
    .article-toc-card {
      width: 240px; flex: 0 0 auto; position: sticky; top: 24px;
      background: #fff; border: 1px solid rgba(0,0,0,.06); border-radius: 16px;
      padding: 20px 16px; max-height: calc(100vh - 48px); overflow-y: auto;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05);
    }
    .article-toc-card::-webkit-scrollbar { width: 4px; }
    .article-toc-card::-webkit-scrollbar-thumb { background: #e8e8ed; border-radius: 2px; }
    .article-toc-title { font-size: 12px; font-weight: 600; color: #86868b; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; }
    .article-toc-list { display: flex; flex-direction: column; gap: 4px; }
    .article-toc-item { font-size: 13px; line-height: 1.35; color: #555; text-decoration: none; padding: 3px 6px; border-radius: 4px; transition: all .15s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .article-toc-item:hover { background: #f5f5f7; color: #1d1d1f; text-decoration: none; }
    .article-toc-item.level-2 { padding-left: 14px; }
    .article-toc-item.level-3 { padding-left: 24px; }

    /* 右侧作者栏 */
    .article-sidebar {
      width: 64px; flex: 0 0 auto; position: sticky; top: 24px;
      display: flex; flex-direction: column; align-items: center; gap: 14px;
      background: #fff; border: 1px solid rgba(0,0,0,.06); border-radius: 16px;
      padding: 18px 10px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05);
    }
    .article-sidebar-name { font-size: 13px; font-weight: 700; text-align: center; word-break: break-all; }
    .article-sidebar-icons { display: flex; flex-direction: column; gap: 12px; align-items: center; }
    .article-sidebar-icons a {
      width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
      border-radius: 50%; color: #86868b; transition: all .2s;
    }
    .article-sidebar-icons a:hover { background: #f5f5f7; color: #1d1d1f; }

    @media (max-width: 900px) {
      .article-shell { flex-direction: column; }
      .article-toc-card { width: 100%; position: static; max-height: none; }
      .article-sidebar { width: 100%; flex-direction: row; justify-content: center; position: static; }
      .article-sidebar-icons { flex-direction: row; }
    }
    @media (max-width: 600px) {
      .article-hd { padding: 20px 16px; }
      .article-body { padding: 20px 16px; }
      .article-hd h1 { font-size: 20px; }
      .comment-section { padding: 18px 16px; }
      .comment-content { padding-left: 0; }
      .comment-children { padding-left: 16px; }
    }
  </style>
</head>
<body class="page-article">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <div class="article-shell container" data-article-id="{{ .ArticleID }}" id="page">
    <!-- 左侧目录 -->
    <aside class="article-toc-card" id="articleTocCard" style="display:none">
      <div class="article-toc-title">目录</div>
      <nav id="articleToc" class="article-toc-list"></nav>
    </aside>

    <!-- 主体 -->
    <main class="article-main">
      <!-- 文章头部 -->
      <div class="article-hd">
        <figure class="article-cover" id="articleCoverWrap" hidden>
          <img id="articleCoverImg" alt="" loading="lazy" decoding="async" />
        </figure>
        <h1 id="articleTitle">加载中...</h1>
        <div class="article-meta" id="articleMeta"></div>
        <div class="article-tags" id="articleTags"></div>
        <div class="article-byline">
          <div class="article-author">
            <div class="article-author-avatar" id="authorAvatar">?</div>
            <div class="article-author-info">
              <div class="article-author-name" id="authorName">加载中...</div>
              <div class="article-author-extra muted" id="authorExtra"></div>
            </div>
          </div>
          <div class="article-actions-wrap">
            <div class="article-actions">
              <button type="button" class="article-action-btn" id="likeBtn" title="点赞" aria-label="点赞"><span aria-hidden="true">👍</span><span class="article-like-count" id="likeCount">0</span></button>
              <button type="button" class="article-action-btn" id="collectBtn" title="收藏" aria-label="收藏"><span aria-hidden="true">🔖</span></button>
              <button type="button" class="article-action-btn" id="followBtn" style="display:none" title="关注作者" aria-label="关注作者"><span aria-hidden="true">＋</span></button>
            </div>
            <div class="article-action-hint" id="actionHint" aria-live="polite"></div>
          </div>
        </div>
      </div>

      <!-- 正文 -->
      <div class="article-body">
        <div class="content" id="articleContent"></div>
      </div>

      <!-- 评论 -->
      <div class="comment-section">
        <h2>💬 评论 <span style="font-size:13px;font-weight:400;color:#86868b" id="commentCount"></span></h2>

        <div class="comment-input-wrap" id="commentForm">
          <div class="comment-editor-host" id="commentEditorHost">
            <div class="cy-float-pop" id="cyFloatPop">
              <button type="button" class="cy-insert-btn" id="cyInsertBtn" title="插入插眼标记，本条将以 CY 类型发送">👁 CY</button>
            </div>
            <textarea id="commentInput" rows="3" placeholder="善语结善缘，理性讨论…（Ctrl+Enter 发送）" autocomplete="off"></textarea>
          </div>
          <div class="comment-input-footer">
            <div class="comment-input-left">
              <span class="comment-reply-hint" id="replyHint"></span>
              <span class="comment-msg" id="cyModeHint" style="display:none;font-size:12px;color:#8a6d00;font-weight:500">已启用 CY：将带 👁 标记发送</span>
            </div>
            <div class="comment-input-right">
              <span class="comment-msg" id="commentCharCount" style="font-variant-numeric:tabular-nums"></span>
              <span class="comment-msg" id="commentMsg"></span>
              <button type="button" class="comment-submit-btn" id="commentSubmitBtn">发送</button>
            </div>
          </div>
        </div>

        <div class="comment-list" id="commentList"></div>
        <div class="comment-empty" id="commentEmpty"></div>
      </div>
    </main>

    <!-- 右侧作者 -->
    <aside class="article-sidebar" id="authorSidebar">
      <div class="article-sidebar-name" id="sideAuthorName">-</div>
      <div class="article-sidebar-icons">
        <a href="#" id="sideHomeLink" title="作者主页">🏠</a>
        <a href="#" id="sideGithubLink" title="GitHub" target="_blank">🐙</a>
        <a href="#" id="sideMailLink" title="私信">✉</a>
      </div>
    </aside>
  </div>

  <script src="/static/vendor/marked.min.js"></script>
  <script src="/static/vendor/highlight.min.js"></script>
  <script src="/static/app.js"></script>
  <script src="/static/article.js"></script>
</body>
</html>
