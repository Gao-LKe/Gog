<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>游戏库 - GameBog</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    .page-gl {
      background: linear-gradient(180deg, #0f1114 0%, #1a1d24 40%, #12151a 100%);
      min-height: 100vh;
      color: #e8eaed;
    }
    .page-gl .topbar {
      background: rgba(15,17,20,.92);
      border-bottom: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(10px);
    }
    .page-gl .brand a { color: #fff; }
    .page-gl .nav a {
      background: rgba(255,255,255,.06);
      border-color: rgba(255,255,255,.12);
      color: #e8eaed;
    }
    .page-gl .nav a:hover { border-color: rgba(255,255,255,.35); }
    .page-gl .nav a.nav-active {
      background: linear-gradient(135deg, #3d8bfd, #7c5cff);
      border-color: transparent;
      color: #fff;
    }

    .gl-wrap { max-width: 1180px; margin: 0 auto; padding: 24px 16px 48px; }

    .gl-page-hd { margin-bottom: 22px; }
    .gl-page-hd h1 {
      font-size: clamp(22px, 3vw, 28px);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 0 0 8px;
      background: linear-gradient(90deg, #fff, #a8b0c4);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .gl-page-hd p { margin: 0; font-size: 14px; color: #8b919a; }

    .gl-section-label {
      font-size: 13px;
      font-weight: 600;
      color: #8b919a;
      margin: 0 0 12px;
      letter-spacing: .04em;
    }

    /* 精选：每屏一张长卡，左右 ‹ › 平移；封面固定 16:9 + 最大高度，避免被纵向拉变形 */
    .gl-carousel {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-bottom: 28px;
    }
    .gl-car-btn {
      flex: 0 0 auto;
      border: none;
      background: transparent;
      color: rgba(255, 255, 255, 0.45);
      font-size: clamp(36px, 5vw, 52px);
      font-weight: 300;
      line-height: 1;
      padding: 4px 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color .15s, transform .12s;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    .gl-car-btn:hover {
      color: rgba(255, 255, 255, 0.95);
      background: transparent;
    }
    .gl-car-btn:active { transform: scale(0.92); color: #fff; }
    .gl-car-viewport {
      flex: 1;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,.1);
      background: rgba(0,0,0,.2);
    }
    .gl-car-track {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      height: auto;
      will-change: transform;
      transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .gl-car-track.no-anim { transition: none; }
    .gl-car-half {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      flex-shrink: 0;
      height: auto;
      align-items: flex-start;
    }
    .gl-car-slide {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 14px;
      padding: 12px 14px;
      box-sizing: border-box;
      flex-shrink: 0;
    }
    /* 精选区内长卡：封面区域限制高度，图片不变形拉长 */
    .gl-car-viewport .gl-stripe-long .gl-cover {
      aspect-ratio: 16 / 9;
      width: 100%;
      max-height: min(38vw, 360px);
      height: auto;
      object-fit: cover;
      flex-shrink: 0;
    }
    .gl-car-viewport .gl-stripe-card.gl-stripe-long {
      align-self: flex-start;
      width: 100%;
    }
    /* 精选每屏仅一张长卡，铺满视口宽度 */
    .gl-car-slide .gl-stripe-long {
      flex: 1 1 auto;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .gl-stripe-card {
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.1);
      background: linear-gradient(165deg, rgba(40,44,54,.95), rgba(22,24,30,.98));
      box-shadow: 0 12px 40px rgba(0,0,0,.42);
      display: flex;
      flex-direction: column;
    }
    .gl-stripe-long { flex: 0 0 min(76vw, 460px); }
    .gl-stripe-short { flex: 0 0 min(44vw, 260px); }
    .gl-stripe-card .gl-cover {
      width: 100%;
      object-fit: cover;
      display: block;
      background: #222;
    }
    .gl-stripe-long .gl-cover { aspect-ratio: 16 / 9; }
    .gl-stripe-short .gl-cover { aspect-ratio: 1 / 1; min-height: 0; }
    .gl-stripe-body { padding: 14px 16px 16px; flex: 1; display: flex; flex-direction: column; }
    .gl-stripe-body.is-compact { padding: 10px 12px 12px; }
    .gl-stripe-title {
      font-size: 17px;
      font-weight: 700;
      margin: 0 0 6px;
      color: #fff;
      line-height: 1.25;
    }
    .gl-stripe-title.is-sm { font-size: 14px; font-weight: 600; }
    .gl-stripe-short .gl-price { font-size: 16px; }
    .gl-stripe-long .gl-price { font-size: 19px; }
    .gl-price-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
    .gl-price { font-size: 20px; font-weight: 800; color: #5cffb0; }
    .gl-price.is-paid { color: #5cffb0; }
    .gl-price.is-free { color: #7dd3fc; font-size: 17px; font-weight: 700; }
    .gl-price.is-unknown { color: #8b919a; font-size: 15px; font-weight: 600; }
    .gl-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .gl-tag {
      font-size: 11px;
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(124,92,255,.2);
      color: #c4b5fd;
      border: 1px solid rgba(124,92,255,.35);
    }

    /* 全部游戏：长卡区 + 网格 交替 */
    .gl-loop-hint {
      font-size: 12px;
      color: #6b7280;
      margin: 0 0 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .gl-loop-hint span { color: #5cffb0; }

    .gl-loop-viewport {
      max-height: min(78vh, 900px);
      overflow-y: auto;
      overflow-x: hidden;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,.1);
      background: rgba(0,0,0,.25);
      scrollbar-gutter: stable;
    }
    .gl-loop-viewport::-webkit-scrollbar { width: 8px; }
    .gl-loop-viewport::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,.18);
      border-radius: 8px;
    }

    .gl-catalog-block { margin-bottom: 26px; }
    .gl-catalog-block:last-child { margin-bottom: 0; }
    .gl-catalog-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: #6b7280;
      margin: 0 0 10px;
    }
    .gl-catalog-hero-inner {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 14px;
      align-items: stretch;
    }
    .gl-catalog-hero-inner .gl-stripe-long {
      flex: 1 1 calc(50% - 7px);
      min-width: min(100%, 300px);
      max-width: 100%;
    }
    @media (max-width: 700px) {
      .gl-catalog-hero-inner { flex-direction: column; }
      .gl-catalog-hero-inner .gl-stripe-long { flex: 1 1 auto; width: 100%; }
    }

    .gl-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    @media (max-width: 900px) {
      .gl-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 520px) {
      .gl-grid { grid-template-columns: 1fr; }
    }

    .gl-card {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.08);
      background: rgba(30,33,40,.9);
      transition: transform .18s, border-color .18s, box-shadow .18s;
    }
    .gl-card:hover {
      transform: translateY(-3px);
      border-color: rgba(61,139,253,.45);
      box-shadow: 0 12px 32px rgba(61,139,253,.15);
    }
    .gl-card .gl-cover {
      aspect-ratio: 16 / 10;
      width: 100%;
      object-fit: cover;
      display: block;
      background: #222;
    }
    .gl-card-body { padding: 12px 12px 14px; }
    .gl-card-title {
      font-size: 14px;
      font-weight: 600;
      color: #f3f4f6;
      margin: 0 0 8px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .gl-card .gl-price { font-size: 15px; }
    .gl-card .gl-tags { margin-top: 8px; }

    .gl-catalog-grid-wrap {
      padding: 4px 2px 2px;
    }

  </style>
</head>
<body class="page-gl">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary" class="nav-active">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
        <button type="button" id="navLogout" style="display:none">退出</button>
      </nav>
    </div>
  </header>

  <main class="gl-wrap">
    <header class="gl-page-hd">
      <h1>游戏库</h1>
      <p><strong>精选</strong>每屏一张推荐，两侧按钮切换。<strong>全部游戏</strong>来自后端接口与 Redis 列表缓存；向下滚动为双份无缝循环。</p>
    </header>

    <p class="gl-section-label">精选</p>
    <div class="gl-carousel" id="glCarousel">
      <button type="button" class="gl-car-btn" id="glFeatPrev" aria-label="上一组">‹</button>
      <div class="gl-car-viewport" id="glCarViewport">
        <div class="gl-car-track" id="glCarTrack">
          <div class="gl-car-half" id="glCarHalfA"></div>
          <div class="gl-car-half" id="glCarHalfB" aria-hidden="true"></div>
        </div>
      </div>
      <button type="button" class="gl-car-btn" id="glFeatNext" aria-label="下一组">›</button>
    </div>

    <p class="gl-section-label" style="margin-top:8px">全部游戏 · 长卡区 + 网格循环</p>
    <p class="gl-loop-hint"><span>↕</span> 向下滚动；内容与高度复制一份，首尾无缝衔接。</p>
    <div class="gl-loop-viewport" id="glLoopViewport" tabindex="0">
      <div class="gl-loop-track" id="glLoopTrack">
        <div id="glLoopA"></div>
        <div id="glLoopB" aria-hidden="true"></div>
      </div>
    </div>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/game_library.js"></script>
</body>
</html>
