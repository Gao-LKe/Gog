<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>话题详情 - GameBog</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    .page-topic {
      background: linear-gradient(180deg, #f6f7f9 0%, #eef0f4 100%);
      min-height: 100vh;
    }
    .page-topic .container { max-width: 920px; }

    .topic-detail-wrap { padding: 32px 0 48px; }

    .topic-detail-header {
      background: #fff;
      border: 1px solid rgba(0,0,0,.06);
      border-radius: 20px;
      padding: 32px 32px 26px;
      margin-bottom: 22px;
      position: relative;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
    }
    .topic-detail-title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }
    .topic-detail-title-block { flex: 1; min-width: 0; }
    .topic-detail-title-row h1 {
      font-size: clamp(20px, 2.2vw, 26px);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0;
      line-height: 1.28;
      color: #0a0a0b;
    }
    .topic-detail-head-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
      flex-shrink: 0;
    }
    .topic-follow-btn {
      display: none;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 999px;
      border: 1px solid rgba(0,113,227,.35);
      background: rgba(0,113,227,.08);
      color: #0071e3;
      cursor: pointer;
      transition: background .2s, border-color .2s, color .2s, box-shadow .2s;
      white-space: nowrap;
    }
    .topic-follow-btn:hover {
      background: rgba(0,113,227,.14);
      box-shadow: 0 4px 14px rgba(0,113,227,.2);
    }
    .topic-follow-btn.is-active {
      background: #0071e3;
      border-color: #0071e3;
      color: #fff;
    }
    .topic-follow-btn:disabled { opacity: .55; cursor: not-allowed; box-shadow: none; }
    .topic-follow-hint {
      font-size: 12px;
      color: #86868b;
      text-align: right;
      max-width: 200px;
      min-height: 1.2em;
    }
    .topic-detail-badge {
      font-size: 12px;
      padding: 3px 10px;
      border-radius: 999px;
      font-weight: 500;
      white-space: nowrap;
      flex-shrink: 0;
      margin-top: 4px;
    }
    .badge-permanent { background: #e8f5e9; color: #2e7d32; }
    .badge-temporary { background: #fff3e0; color: #e65100; }

    .topic-detail-meta {
      font-size: 13px;
      color: #6e6e73;
      margin-top: 12px;
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    .topic-detail-meta .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(0,0,0,.04);
      font-weight: 500;
      color: #424245;
    }
    .topic-detail-actions {
      margin-top: 14px;
      display: flex;
      gap: 8px;
    }
    .topic-detail-actions a,
    .topic-detail-actions button {
      padding: 6px 14px;
      font-size: 13px;
      border-radius: 8px;
      border: 1px solid #e8e8ed;
      background: #fff;
      color: #1d1d1f;
      text-decoration: none;
      cursor: pointer;
      transition: all .15s;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .topic-detail-actions a:hover,
    .topic-detail-actions button:hover { background: #f5f5f7; }
    .topic-detail-actions .btn-danger { color: #e74c3c; border-color: #f5c6c6; }
    .topic-detail-actions .btn-danger:hover { background: #fef2f2; }

    .topic-section {
      background: #fff;
      border: 1px solid rgba(0,0,0,.06);
      border-radius: 20px;
      padding: 26px 30px;
      margin-bottom: 22px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
    }
    .topic-section h2 {
      font-size: 17px;
      font-weight: 700;
      margin: 0 0 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .topic-discuss-cta {
      display: flex;
      flex-direction: column;
      gap: 14px;
      align-items: flex-start;
    }
    .topic-discuss-cta p {
      margin: 0;
      font-size: 14px;
      line-height: 1.55;
      color: #6e6e73;
      max-width: 520px;
    }
    .topic-discuss-cta .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 22px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 12px;
      background: #0071e3;
      color: #fff;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background .2s;
    }
    .topic-discuss-cta .cta-btn:hover { background: #0058b0; }

    /* 文章列表 */
    .article-list { display: flex; flex-direction: column; gap: 8px; }
    .article-item {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      background: #f9f9fb;
      border-radius: 12px;
      transition: all .2s;
    }
    .article-item:hover { background: #f0f0f2; }
    .article-item-thumb {
      flex: 0 0 112px;
      width: 112px;
      height: 72px;
      object-fit: cover;
      border-radius: 8px;
      background: #e8e8ed;
    }
    .article-item-body { flex: 1; min-width: 0; }
    .article-item-title {
      font-size: 15px;
      font-weight: 600;
      color: #1d1d1f;
      text-decoration: none;
      display: block;
      margin-bottom: 4px;
    }
    .article-item-title:hover { text-decoration: underline; }
    .article-item-summary {
      font-size: 13px;
      color: #86868b;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .article-empty {
      text-align: center;
      padding: 40px 20px;
      color: #a1a1a6;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      .topic-detail-header { padding: 20px 16px; }
      .topic-section { padding: 18px 16px; }
      .topic-detail-title-row h1 { font-size: 20px; }
    }
  </style>
</head>
<body class="page-topic">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <div class="topic-detail-wrap container" id="topicPage" data-topic-id="{{ .TopicID }}">
    <!-- 话题头部 -->
    <div class="topic-detail-header">
      <div class="topic-detail-title-row">
        <div class="topic-detail-title-block">
          <h1 id="topicTitle">加载中...</h1>
          <span class="topic-detail-badge" id="topicBadge" style="display:inline-block;margin-top:10px"></span>
        </div>
        <div class="topic-detail-head-actions">
          <button type="button" class="topic-follow-btn" id="topicFollowBtn" aria-pressed="false">
            <span aria-hidden="true">☆</span><span id="topicFollowBtnText">关注话题</span>
          </button>
          <div class="topic-follow-hint" id="topicFollowHint" aria-live="polite"></div>
        </div>
      </div>
      <div class="topic-detail-meta" id="topicMeta"></div>
      <div class="topic-detail-actions">
        <a href="/topics">← 返回话题列表</a>
        <a href="/editor?topic_id={{ .TopicID }}">+ 写文章</a>
        <button id="topicDeleteBtn" class="btn-danger" style="display:none">🗑 删除</button>
      </div>
    </div>

    <!-- 讨论在独立页，避免与文章详情混用同一套区块 -->
    <div class="topic-section">
      <h2>💬 讨论</h2>
      <div class="topic-discuss-cta">
        <p>完整留言列表与发言在「讨论区」页面；列表区域可上下滚动查看更早消息。</p>
        <a class="cta-btn" href="/topic/{{ .TopicID }}/discuss">进入讨论区</a>
      </div>
    </div>

    <!-- 相关文章 -->
    <div class="topic-section">
      <h2>📄 相关文章</h2>
      <div class="article-list" id="topicArticles"></div>
      <div class="article-empty" id="topicArticlesEmpty" style="display:none">暂无相关文章</div>
    </div>
  </div>

  <script src="/static/app.js"></script>
  <script src="/static/topic.js"></script>
</body>
</html>
