<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>话题讨论 - GameBog</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    .page-topic { background: var(--bg); }
    .page-topic .container { max-width: 900px; }
    .topic-detail-wrap { padding-top: 28px; }

    .topic-section {
      background: #fff;
      border: 1px solid #e8e8ed;
      border-radius: 16px;
      padding: 24px 28px;
      margin-bottom: 20px;
    }
    .topic-section h2 { font-size: 17px; font-weight: 700; margin: 0 0 16px; display: flex; align-items: center; gap: 8px; }

    /* 对话列表：大块展示区域（编辑框保持下方单行紧凑） */
    .discuss-box {
      max-height: min(720px, 72vh);
      min-height: 420px;
      overflow-y: auto;
      scrollbar-gutter: stable;
      padding: 16px 14px;
      scroll-behavior: smooth;
      border: 1px solid rgba(0, 113, 227, 0.12);
      border-radius: 18px;
      background:
        radial-gradient(ellipse 110% 85% at 100% -5%, rgba(120, 200, 255, 0.22) 0%, transparent 52%),
        radial-gradient(ellipse 90% 75% at -5% 105%, rgba(175, 160, 255, 0.14) 0%, transparent 48%),
        linear-gradient(168deg, #fbfdff 0%, #f2f8ff 42%, #eaf3ff 100%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        inset 0 -1px 0 rgba(0, 113, 227, 0.04);
    }
    .discuss-box::-webkit-scrollbar { width: 10px; }
    .discuss-box::-webkit-scrollbar-thumb {
      background: rgba(0, 113, 227, 0.28);
      border-radius: 8px;
      border: 2px solid rgba(236, 244, 255, 0.9);
    }
    .discuss-box::-webkit-scrollbar-thumb:hover { background: rgba(0, 113, 227, 0.42); }
    .discuss-box::-webkit-scrollbar-track { background: rgba(0, 113, 227, 0.06); border-radius: 8px; }

    .discuss-item {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
      animation: discussIn .28s ease;
      align-items: flex-end;
    }
    .discuss-item-me { flex-direction: row-reverse; }
    @keyframes discussIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .discuss-item:last-child { margin-bottom: 0; }

    .discuss-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }
    .discuss-avatar-me { background: linear-gradient(145deg, #0a84ff, #0071e3); color: #fff; }
    .discuss-avatar-other { background: #fff; color: #555; border: 1px solid rgba(0,0,0,.06); }

    .discuss-body {
      flex: 1;
      min-width: 0;
      max-width: min(100%, 560px);
      display: flex;
      flex-direction: column;
    }
    .discuss-item-me .discuss-body { align-items: flex-end; margin-left: auto; }
    .discuss-item-other .discuss-body { align-items: flex-start; }

    .discuss-bubble {
      border-radius: 16px;
      padding: 10px 14px 12px;
      border: 1px solid rgba(0,0,0,.06);
      background: #fff;
      box-shadow: 0 2px 12px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.04);
    }
    .discuss-item-me .discuss-bubble {
      background: linear-gradient(180deg, #e8f3ff 0%, #d9ebff 100%);
      border-color: rgba(0,113,227,.22);
      border-bottom-right-radius: 6px;
    }
    .discuss-item-other .discuss-bubble {
      border-bottom-left-radius: 6px;
    }

    .discuss-header {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 10px;
      margin-bottom: 6px;
    }
    .discuss-item-me .discuss-header { justify-content: flex-end; }
    .discuss-name { font-size: 13px; font-weight: 700; color: #3a3a3c; }
    .discuss-name-me { color: #0071e3; }
    .discuss-time { font-size: 12px; color: #8e8e93; font-variant-numeric: tabular-nums; }
    .discuss-content {
      font-size: 15px;
      line-height: 1.55;
      color: #1d1d1f;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .discuss-empty {
      text-align: center;
      padding: 48px 20px;
      color: #8e8e93;
      font-size: 14px;
      line-height: 1.5;
    }

    .discuss-input-area {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      align-items: flex-end;
    }
    .discuss-input-wrap {
      flex: 1;
      background: #f5f5f7;
      border: 1px solid #e8e8ed;
      border-radius: 12px;
      padding: 8px 12px;
      transition: border-color .2s, box-shadow .2s;
    }
    .discuss-input-wrap:focus-within {
      border-color: rgba(0,113,227,.45);
      box-shadow: 0 0 0 3px rgba(0,113,227,.1);
      background: #fff;
    }
    .discuss-input-wrap textarea {
      width: 100%;
      border: none;
      outline: none;
      resize: none;
      font-size: 14px;
      font-family: inherit;
      line-height: 1.45;
      background: transparent;
      min-height: 22px;
      max-height: 96px;
      padding: 0;
    }
    .discuss-send-btn {
      padding: 8px 18px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      background: #0071e3;
      color: #fff;
      cursor: pointer;
      transition: background .2s;
      white-space: nowrap;
      flex-shrink: 0;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .discuss-send-btn:hover { background: #0058b0; }
    .discuss-send-btn:active { transform: scale(.98); }

    @media (max-width: 600px) {
      .topic-section { padding: 18px 16px; }
      .discuss-box {
        min-height: min(360px, 52vh);
        max-height: min(620px, 68vh);
      }
      .discuss-input-area { flex-direction: column; align-items: stretch; }
      .discuss-send-btn { width: 100%; height: auto; min-height: 44px; }
      .discuss-body { max-width: 100%; }
    }
  </style>
</head>
<body class="page-topic">
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
      </nav>
    </div>
  </header>

  <div class="topic-detail-wrap container" id="topicPage" data-topic-id="{{ .TopicID }}">
    <div class="topic-section">
      <h1 id="topicTitle" style="font-size:22px;font-weight:700;margin:0 0 8px">加载中...</h1>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px">
        <a href="/topic/{{ .TopicID }}" style="padding:5px 12px;font-size:12px;border-radius:8px;border:1px solid #e8e8ed;color:#1d1d1f;text-decoration:none">← 返回话题</a>
      </div>
      <div class="muted" id="topicMeta" style="font-size:13px;color:#86868b;margin-bottom:16px"></div>
      <h2 style="font-size:17px;font-weight:700;margin:0 0 6px">💬 讨论</h2>
      <p class="muted" style="font-size:12px;color:#86868b;margin:0 0 12px">消息按时间从早到晚排列；列表可上下滚动查看更早内容。</p>
      <div class="discuss-box" id="topicChatBox">
        <div id="topicDiscussions"></div>
        <div class="discuss-empty" id="topicDiscussionsEmpty" style="display:none">暂无讨论</div>
      </div>
      <div class="discuss-input-area">
        <div class="discuss-input-wrap">
          <textarea id="topicDiscussionInput" rows="1" placeholder="发消息（Enter 发送，Shift+Enter 换行）"></textarea>
        </div>
        <button class="discuss-send-btn" id="discussSendBtn">发送</button>
      </div>
      <div class="muted" id="topicDiscussionMsg" style="font-size:12px;color:#86868b;margin-top:6px"></div>
    </div>
  </div>

  <script src="/static/app.js"></script>
  <script src="/static/topic.js"></script>
</body>
</html>
