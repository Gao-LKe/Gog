<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>游戏详情 - GameBog</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    .page-gd {
      background: linear-gradient(180deg, #0f1114 0%, #1a1d24 40%, #12151a 100%);
      min-height: 100vh;
      color: #e8eaed;
    }
    .page-gd .topbar {
      background: rgba(15,17,20,.92);
      border-bottom: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(10px);
    }
    .page-gd .brand a { color: #fff; }
    .page-gd .nav a {
      background: rgba(255,255,255,.06);
      border-color: rgba(255,255,255,.12);
      color: #e8eaed;
    }
    .gd-wrap { max-width: 920px; margin: 0 auto; padding: 24px 16px 48px; }
    .gd-back { display: inline-block; margin-bottom: 16px; font-size: 14px; color: #7dd3fc; text-decoration: none; }
    .gd-back:hover { text-decoration: underline; }
    .gd-cover {
      width: 100%;
      border-radius: 16px;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border: 1px solid rgba(255,255,255,.1);
      background: #222;
    }
    .gd-title {
      font-size: clamp(22px, 4vw, 30px);
      font-weight: 800;
      margin: 20px 0 8px;
      color: #fff;
    }
    .gd-sub { font-size: 14px; color: #8b919a; margin-bottom: 16px; }
    .gd-desc {
      font-size: 15px;
      line-height: 1.65;
      color: #c9cdd4;
      white-space: pre-wrap;
    }
    .gd-meta {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
      margin-top: 24px;
      padding: 16px;
      border-radius: 12px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
      font-size: 14px;
    }
    .gd-meta dt { color: #6b7280; margin-bottom: 4px; }
    .gd-meta dd { margin: 0; color: #e8eaed; }

    .gd-reviews {
      margin-top: 36px;
      padding-top: 28px;
      border-top: 1px solid rgba(255,255,255,.08);
    }
    .gd-reviews-hd {
      font-size: 18px;
      font-weight: 700;
      margin: 0 0 14px;
      color: #fff;
      letter-spacing: -0.02em;
    }
    .gd-review-composer {
      margin-bottom: 22px;
      padding: 16px;
      border-radius: 14px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.1);
    }
    .gd-review-label { display: block; font-size: 12px; color: #8b919a; margin-bottom: 6px; }
    .gd-review-select {
      width: 100%;
      max-width: 200px;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.35);
      color: #e8eaed;
      font-size: 14px;
      margin-bottom: 12px;
    }
    .gd-review-textarea {
      width: 100%;
      min-height: 120px;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.35);
      color: #e8eaed;
      font-size: 14px;
      line-height: 1.5;
      resize: vertical;
      font-family: inherit;
    }
    .gd-review-actions { margin-top: 12px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .gd-review-submit {
      padding: 10px 20px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(135deg, #3d8bfd, #7c5cff);
      color: #fff;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
    }
    .gd-review-submit:disabled { opacity: .55; cursor: not-allowed; }
    .gd-review-cancel {
      padding: 10px 16px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.2);
      background: transparent;
      color: #c9cdd4;
      font-size: 14px;
      cursor: pointer;
    }
    .gd-review-cancel:hover { border-color: rgba(255,255,255,.35); color: #fff; }
    .gd-review-msg { font-size: 13px; }
    .gd-reviews-list { display: flex; flex-direction: column; gap: 14px; }
    .gd-review-item {
      padding: 16px;
      border-radius: 14px;
      background: rgba(255,255,255,.03);
      border: 1px solid rgba(255,255,255,.07);
    }
    .gd-review-item-hd {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 14px;
      margin-bottom: 10px;
      font-size: 13px;
    }
    .gd-review-user { font-weight: 700; color: #fff; }
    .gd-review-stars { color: #fbbf24; letter-spacing: 2px; }
    .gd-review-time { color: #6b7280; margin-left: auto; font-variant-numeric: tabular-nums; }
    .gd-review-body {
      font-size: 14px;
      line-height: 1.6;
      color: #c9cdd4;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .gd-review-own { margin-top: 12px; display: flex; gap: 12px; }
    .gd-review-linkbtn {
      padding: 0;
      border: none;
      background: none;
      color: #7dd3fc;
      font-size: 13px;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .gd-review-linkbtn.danger { color: #f87171; }
    .gd-reviews-empty { font-size: 14px; color: #6b7280; margin: 0 0 16px; }
    .gd-review-err { color: #f87171; font-size: 14px; margin: 0; }
  </style>
</head>
<body class="page-gd">
  <input type="hidden" id="glGameId" value="{{ .GameID }}" />
  <header class="topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <nav class="nav">
        <a href="/" id="navHome">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
        <button type="button" id="navLogout" style="display:none">退出</button>
      </nav>
    </div>
  </header>

  <main class="gd-wrap">
    <a class="gd-back" href="/game-library">← 返回游戏库</a>
    <img id="glDetailCover" class="gd-cover" src="" alt="" />
    <h1 class="gd-title" id="glDetailTitle">加载中…</h1>
    <p class="gd-sub" id="glDetailSub"></p>
    <p class="gd-desc" id="glDetailDesc"></p>
    <dl class="gd-meta">
      <div><dt>参考价格</dt><dd id="glDetailPrice">—</dd></div>
      <div><dt>标签</dt><dd id="glDetailTags">—</dd></div>
      <div><dt>发行商</dt><dd id="glDetailPub">—</dd></div>
      <div><dt>开发商</dt><dd id="glDetailDev">—</dd></div>
      <div><dt>发售日</dt><dd id="glDetailDate">—</dd></div>
    </dl>

    <section class="gd-reviews" id="glReviewsSection">
      <h2 class="gd-reviews-hd">玩家点评</h2>
      <p id="glReviewsLoginHint" class="gd-reviews-empty" style="margin-bottom:12px">登录后可发表点评；每位玩家对同一游戏限一条点评。</p>
      <div id="glReviewComposer" class="gd-review-composer" style="display:none">
        <label class="gd-review-label" for="glReviewRating">评分（1～5 星）</label>
        <select id="glReviewRating" class="gd-review-select">
          <option value="5">5 星 · 强推</option>
          <option value="4">4 星 · 推荐</option>
          <option value="3">3 星 · 尚可</option>
          <option value="2">2 星 · 一般</option>
          <option value="1">1 星 · 不推荐</option>
        </select>
        <label class="gd-review-label" for="glReviewContent">内容</label>
        <textarea id="glReviewContent" class="gd-review-textarea" placeholder="写下你的游玩感受、优缺点…"></textarea>
        <div class="gd-review-actions">
          <button type="button" class="gd-review-submit" id="glReviewSubmit">发表点评</button>
          <button type="button" class="gd-review-cancel" id="glReviewCancel" style="display:none">取消编辑</button>
          <span class="gd-review-msg" id="glReviewMsg"></span>
        </div>
      </div>
      <p id="glReviewsEmpty" class="gd-reviews-empty" style="display:none">暂时还没有点评。</p>
      <div id="glReviewsList" class="gd-reviews-list"></div>
    </section>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/game_detail.js"></script>
</body>
</html>
