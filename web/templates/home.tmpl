<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GameBog - 首页</title>
  <link rel="stylesheet" href="/static/styles.css" />
  <style>
    .page-home {
      background: linear-gradient(180deg, #f6f7f9 0%, #eef0f4 100%);
      min-height: 100vh;
    }
    .page-home .container { max-width: 1120px; }

    .home-hero {
      padding: 36px 0 8px;
    }
    .home-hero-inner {
      background: #fff;
      border: 1px solid rgba(0,0,0,.06);
      border-radius: 20px;
      padding: 32px 36px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
      position: relative;
      overflow: hidden;
    }
    .home-hero-inner::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, #0071e3, #5ac8fa, #af52de);
      opacity: .9;
    }
    .home-hero-kicker {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #86868b;
      margin: 0 0 10px;
    }
    .home-hero-title {
      font-size: clamp(26px, 3vw, 34px);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #0a0a0b;
      margin: 0 0 10px;
      line-height: 1.2;
    }
    .home-hero-desc {
      font-size: 15px;
      color: #6e6e73;
      line-height: 1.55;
      margin: 0 0 22px;
      max-width: 520px;
    }
    .home-hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .home-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 12px;
      text-decoration: none;
      border: 1px solid rgba(0,0,0,.1);
      background: #f5f5f7;
      color: #1d1d1f;
      transition: background .15s, border-color .15s, transform .12s;
    }
    .home-btn:hover {
      background: #ebebed;
      border-color: rgba(0,0,0,.14);
      text-decoration: none;
    }
    .home-btn:active { transform: scale(.98); }
    .home-btn-primary {
      background: #0071e3;
      border-color: #0071e3;
      color: #fff;
    }
    .home-btn-primary:hover {
      background: #0058b0;
      border-color: #0058b0;
      color: #fff;
    }

    .home-layout {
      display: flex;
      align-items: flex-start;
      gap: 24px;
      padding: 20px 0 48px;
    }
    .home-main { flex: 1; min-width: 0; }
    .home-aside {
      flex: 0 0 300px;
      position: sticky;
      top: 16px;
    }

    .home-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,.06);
      border-radius: 20px;
      padding: 22px 24px;
      margin-bottom: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px rgba(0,0,0,.06);
    }
    .home-card-hd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }
    .home-card-hd h2 {
      margin: 0;
      font-size: 17px;
      font-weight: 700;
      color: #0a0a0b;
      letter-spacing: -0.02em;
    }

    .home-search-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 0 0 8px;
      font-size: 17px;
      font-weight: 700;
    }
    .home-search-close {
      border: none;
      background: rgba(0,0,0,.05);
      width: 32px;
      height: 32px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      color: #424245;
      transition: background .15s;
    }
    .home-search-close:hover { background: rgba(0,0,0,.08); }

    .home-topbar .searchbar {
      max-width: 280px;
      align-items: center;
      gap: 8px;
    }
    .home-topbar .searchbar input[type="search"] {
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #fff;
      padding: 6px 14px;
      font-size: 14px;
      line-height: 1.2;
      flex: 1;
      min-width: 0;
    }
    .home-topbar .searchbar input[type="search"]::placeholder {
      color: #86868b;
    }
    .home-topbar .searchbar button {
      flex-shrink: 0;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text);
      font-weight: 600;
      padding: 6px 14px;
      font-size: 14px;
      line-height: 1.2;
      cursor: pointer;
      transition: border-color .15s, background .15s;
    }
    .home-topbar .searchbar button:hover {
      border-color: #000;
      background: #fff;
    }

    .home-lb-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .home-lb-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(0,0,0,.05);
    }
    .home-lb-row:last-child { border-bottom: none; padding-bottom: 0; }
    .home-lb-rank {
      flex: 0 0 28px;
      height: 28px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      background: #f0f0f2;
      color: #636366;
    }
    .home-lb-row:nth-child(1) .home-lb-rank { background: linear-gradient(135deg, #ffd54f, #ffb300); color: #3e2723; }
    .home-lb-row:nth-child(2) .home-lb-rank { background: linear-gradient(135deg, #e0e0e0, #bdbdbd); color: #424242; }
    .home-lb-row:nth-child(3) .home-lb-rank { background: linear-gradient(135deg, #d7ccc8, #bcaaa4); color: #4e342e; }
    .home-lb-body { flex: 1; min-width: 0; }
    .home-lb-body a {
      font-size: 14px;
      font-weight: 600;
      color: #1d1d1f;
      text-decoration: none;
      display: block;
      line-height: 1.35;
    }
    .home-lb-body a:hover { color: #0071e3; text-decoration: underline; }
    .home-lb-meta { font-size: 12px; color: #86868b; margin-top: 4px; }

    .home-feed-item {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      padding: 16px 18px;
      border-radius: 14px;
      border: 1px solid rgba(0,0,0,.06);
      background: #fafafa;
      margin-bottom: 10px;
      transition: border-color .15s, box-shadow .15s, background .15s;
    }
    .home-feed-thumb {
      flex: 0 0 132px;
      width: 132px;
      height: 84px;
      object-fit: cover;
      border-radius: 10px;
      background: #e8e8ed;
    }
    .home-feed-main { flex: 1; min-width: 0; }
    .home-feed-item:hover {
      background: #fff;
      border-color: rgba(0,113,227,.2);
      box-shadow: 0 4px 16px rgba(0,113,227,.08);
    }
    .home-feed-item:last-child { margin-bottom: 0; }
    .home-feed-title a {
      font-size: 16px;
      font-weight: 600;
      color: #0a0a0b;
      text-decoration: none;
      letter-spacing: -0.02em;
    }
    .home-feed-title a:hover { color: #0071e3; }
    .home-feed-summary {
      font-size: 14px;
      color: #6e6e73;
      line-height: 1.5;
      margin-top: 8px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .home-feed-meta {
      font-size: 12px;
      color: #a1a1a6;
      margin-top: 10px;
    }
    .home-feed-meta .stat { margin-right: 2px; }

    .home-pager {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 18px;
    }
    .home-pager-btn {
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 10px;
      border: 1px solid rgba(0,0,0,.1);
      background: #fff;
      cursor: pointer;
      color: #1d1d1f;
      transition: background .15s, border-color .15s;
    }
    .home-pager-btn:hover:not(:disabled) {
      background: #f5f5f7;
      border-color: rgba(0,0,0,.14);
    }
    .home-pager-btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    .home-pager-info { font-size: 13px; color: #86868b; }

    .home-empty {
      text-align: center;
      padding: 28px 16px;
      color: #a1a1a6;
      font-size: 14px;
    }

    #searchSection .list .item {
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,.06);
      background: #fafafa;
      margin-bottom: 8px;
    }
    #searchSection .list .item:last-child { margin-bottom: 0; }

    @media (max-width: 900px) {
      .home-layout { flex-direction: column; }
      .home-aside {
        position: static;
        flex: 1;
        width: 100%;
        order: -1;
      }
    }
    @media (max-width: 600px) {
      .home-hero-inner { padding: 24px 20px; }
      .home-card { padding: 18px 16px; border-radius: 16px; }
      .home-topbar .searchbar { max-width: 160px; }
    }
  </style>
</head>
<body class="page-home">
  <header class="topbar home-topbar">
    <div class="container row">
      <div class="brand"><a href="/">GameBog</a></div>
      <form id="searchForm" class="searchbar">
        <input type="search" id="searchInput" placeholder="搜索文章或用户" autocomplete="off" />
        <button type="submit">搜索</button>
      </form>
      <nav class="nav">
        <a href="/" id="navHome" class="nav-active">首页</a>
        <a href="/topics" id="navTopics">话题</a>
        <a href="/game-library" id="navGameLibrary">游戏库</a>
        <a href="/me" id="navMe">个人中心</a>
        <a href="/login" id="navLogin">登录</a>
        <button type="button" id="navLogout" style="display:none">退出</button>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="home-hero" aria-label="站点介绍">
      <div class="home-hero-inner">
        <p class="home-hero-kicker">游戏 · 互动 · 购买 · 社区</p>
        <h1 class="home-hero-title">GameBog — 以游戏为主的互动与售卖平台</h1>
        <p class="home-hero-desc">浏览游戏库与攻略文章，参与话题讨论；支持搜索与推荐，登录后可关注动态、下单互动。</p>
        <div class="home-hero-actions">
          <a href="/editor" class="home-btn home-btn-primary">发文章</a>
          <a href="/topics" class="home-btn">浏览话题</a>
          <a href="/game-library" class="home-btn">游戏库</a>
        </div>
      </div>
    </section>

    <div class="home-layout">
      <div class="home-main">
        <section class="home-card" id="searchSection" style="display:none">
          <h2 class="home-search-title">
            <span>搜索结果</span>
            <button type="button" id="searchClose" class="home-search-close" aria-label="关闭搜索结果">×</button>
          </h2>
          <div id="searchMsg" class="muted" style="margin-top:4px"></div>
          <div id="searchResults" style="margin-top:14px;display:none">
            <div>
              <h3 style="font-size:15px;font-weight:600;margin:0 0 8px;color:#424245">文章</h3>
              <div id="searchArticles" class="list"></div>
            </div>
            <div style="margin-top:16px">
              <h3 style="font-size:15px;font-weight:600;margin:0 0 8px;color:#424245">用户</h3>
              <div id="searchUsers" class="list"></div>
            </div>
          </div>
        </section>

        <section class="home-card">
          <div class="home-card-hd">
            <h2>最新文章</h2>
            <div class="latest-toggle" id="latestToggle" style="display:none">
              <button type="button" class="toggle-btn toggle-active" id="latestAllBtn">全部</button>
              <button type="button" class="toggle-btn" id="latestFollowBtn">仅关注</button>
            </div>
          </div>

          <div id="latest"></div>
          <div class="home-empty" id="latestEmpty" style="display:none">暂无文章</div>

          <div class="home-pager" id="latestPager" style="display:none">
            <button type="button" class="home-pager-btn" id="latestPrev">上一页</button>
            <button type="button" class="home-pager-btn" id="latestNext">下一页</button>
            <span class="home-pager-info" id="latestPageInfo"></span>
          </div>
        </section>
      </div>

      <aside class="home-aside">
        <section class="home-card">
          <div class="home-card-hd">
            <h2>本周热榜</h2>
          </div>
          <ol id="leaderboard" class="home-lb-list"></ol>
          <div class="home-empty" id="leaderboardEmpty" style="display:none">暂无数据</div>
        </section>
      </aside>
    </div>
  </main>

  <script src="/static/app.js"></script>
  <script src="/static/search.js"></script>
  <script src="/static/home.js"></script>
</body>
</html>
